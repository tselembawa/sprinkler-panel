# systemd service: the HMI web server. Installed by scripts/install-pi.sh
# (__USER__ and __DIR__ are filled in by the installer).
#
# Watchdog (level 1): the app sends WATCHDOG=1 to systemd only while it is healthy
# (controller answers, database answers, event sync running). If the pings stop for
# WatchdogSec, systemd kills and restarts the service.
#
# Logs:   journalctl -u sprinkler-hmi -f

[Unit]
Description=Sprinkler panel HMI
After=network.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30
User=__USER__
WorkingDirectory=__DIR__/hmi
Environment=SPRINKLER_CONTROLLER=sim
Environment=PYTHONUNBUFFERED=1
# Allows the technician to restart the panel from Settings (see the sudoers rule in install-pi.sh)
Environment=SPRINKLER_REBOOT=1
ExecStart=__DIR__/hmi/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
